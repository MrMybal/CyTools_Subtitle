{
  "schemaVersion": 1,
  "protocolVersion": "1.0",
  "id": "cy.tools.subtitle",
  "name": "CyTools_Subtitle",
  "version": "0.2.1",
  "description": "Local Phonon subtitles with word timing, bounded audio processing, media preview and MCP editing.",
  "vendor": "Cyberalien",
  "author": "Cyberalien",
  "executable": "runtime/python/Scripts/python.exe app/tool.py",
  "categories": [
    "audio",
    "video",
    "subtitles"
  ],
  "tags": [
    "phonon",
    "srt",
    "vtt",
    "accessibility"
  ],
  "capabilities": [
    "jobs",
    "cancellation"
  ],
  "backends": [],
  "platforms": [
    {
      "os": "Windows",
      "architecture": "x64",
      "status": "Experimental",
      "computeBackends": [
        "CPU"
      ]
    },
    {
      "os": "Linux",
      "architecture": "x64",
      "status": "Unknown",
      "computeBackends": [
        "CPU"
      ]
    },
    {
      "os": "macOS",
      "architecture": "ARM64",
      "status": "Unknown",
      "computeBackends": [
        "CPU"
      ]
    }
  ],
  "interfaces": [
    "Native",
