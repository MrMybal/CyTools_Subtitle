              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "audio",
                    "video"
                  ]
                },
                "codec": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                },
                "sampleRate": {
                  "type": "integer"
                },
